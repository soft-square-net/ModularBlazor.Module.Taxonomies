@attribute [ClientDialog(PickTerms, Title = "Choose terms", MaxWidth = "640px")]
@inherits TaxonomiesPageBase

@*
  Dialog "Module.Taxonomies/pick-terms": choose one or more terms from the tenant's schemes, browsing a scheme's tree or
  searching all of them (case, accents and Arabic letter forms ignored).
    parameters  { multiple?: bool, selected?: [ids], scheme?: "sections" (only that scheme) }
    result      { ids: [...], terms: [{ id, name, path, scheme, conceptId }] }   ids as strings, in the order chosen
  Shown on other modules' pages too (the DynamicFields editor, Contents), so its styles are tx- classes only.
*@

<div class="mud-dialog-content tx-picker">
  <form class="tx-picker-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
    @if (_fixedScheme is null && _schemes.Count > 1)
    {
      <div class="mud-input-wrapper mud-input-wrapper--dense mud-input-wrapper--select">
        <select class="mud-input-slot" @bind="_scheme" @bind:after="SearchAsync" aria-label="Scheme">
          <option value="">All schemes</option>
          @foreach (var s in _schemes) { <option value="@s.Key">@s.Name</option> }
        </select>
      </div>
    }
    <div class="mud-input-wrapper mud-input-wrapper--dense tx-picker-query">
      <input type="search" class="mud-input-slot" @bind="_query" @bind:event="oninput" @bind:after="SearchAsync"
             placeholder="Search terms" aria-label="Search terms" autofocus dir="auto" />
    </div>
  </form>

  @if (_multiple && _selected.Count > 0)
  {
    <div class="tx-chips" aria-label="Chosen">
      @foreach (var s in _selected)
      {
        var t = s;
        <span class="mn-chip tx-chip" title="@t.Path">@t.Name <button type="button" class="tx-chip-remove" @onclick="() => Toggle(t)" aria-label="@($"Remove {t.Name}")">✕</button></span>
      }
    </div>
  }

  @if (Error is not null)
  {
    <p class="mud-typography mud-typography-body2 mn-error" role="alert">@Error</p>
  }

  <ul class="tx-picker-results" role="listbox" aria-multiselectable="@(_multiple ? "true" : "false")">
    @{ string? lastScheme = null; }
    @foreach (var item in _results)
    {
      var t = item;
      var on = _selected.Any(s => s.Id == t.Id);
      var searching = _query.Trim().Length > 0;
      @if (_fixedScheme is null && _scheme.Length == 0 && t.SchemeKey != lastScheme)
      {
        lastScheme = t.SchemeKey;
        <li class="tx-picker-scheme" role="presentation">@t.SchemeName</li>
      }
      <li role="option" aria-selected="@(on ? "true" : "false")" class="@(on ? "tx-on" : "")"
          style="--tx-depth: @(searching ? 0 : t.PathNames.Count - 1)" @onclick="() => Pick(t)">
        @if (_multiple) { <input type="checkbox" checked="@on" tabindex="-1" aria-hidden="true" /> }
        <span class="tx-picker-name">
          <strong>@t.Name</strong>
          @if (searching && t.PathNames.Count > 1) { <span class="mn-muted">@string.Join(" › ", t.PathNames.SkipLast(1))</span> }
          @if (t.ConceptId is not null) { <span class="mn-chip tx-concept">◆ @t.ConceptName</span> }
        </span>
      </li>
    }
  </ul>
  @if (_results.Count == 0 && !Busy)
  {
    <p class="mud-typography mud-typography-body2 mn-muted">@(_query.Trim().Length == 0 ? "No terms yet: add them on the Taxonomies page." : $"No term matches \"{_query.Trim()}\".")</p>
  }
  @if (_results.Count == Limit) { <p class="mud-typography mud-typography-body2 mn-muted">Showing the first @Limit: search to find others.</p> }
</div>
<div class="mud-dialog-actions">
  <button type="button" class="mud-button-root mud-button-text mud-button-medium" @onclick="Dialog.Cancel">Cancel</button>
  @if (_multiple)
  {
    <button type="button" class="mud-button-root mud-button-filled mud-button-primary mud-button-medium" @onclick="Done">Choose (@_selected.Count)</button>
  }
</div>

@code {
  /// <summary>The dialog's id: the contract other modules use, with the parameters and result above.</summary>
  public const string PickTerms = "Module.Taxonomies/pick-terms";

  [CascadingParameter] public IDialogReference Dialog { get; set; } = default!;

  /// <summary>The caller's parameters (web JSON).</summary>
  private sealed record Parameters(bool? Multiple, List<string>? Selected, string? Scheme);

  private const int Limit = 100;

  private bool _multiple;
  private string? _fixedScheme;
  private IReadOnlyList<SchemeSummaryDto> _schemes = [];
  private List<TermRefDto> _results = [];
  private readonly List<TermRefDto> _selected = [];
  private string _query = "";
  private string _scheme = "";
  private int _searchNumber;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;
    var parameters = Dialog.GetParameters<Parameters>();
    _multiple = parameters?.Multiple == true;
    _fixedScheme = string.IsNullOrWhiteSpace(parameters?.Scheme) ? null : parameters.Scheme.Trim();
    var selected = (parameters?.Selected ?? []).Select(s => int.TryParse(s, out var n) ? n : 0).Where(n => n > 0).Distinct().ToList();

    await RunAsync(async () =>
    {
      _schemes = await Api.ListSchemesAsync();
      if (_fixedScheme is null && _schemes.Count == 1) _scheme = _schemes[0].Key;
      if (selected.Count > 0) _selected.AddRange(await Api.LookupTermsAsync(selected));
    }, toast: false);
    await SearchAsync();
  }

  private async Task SearchAsync()
  {
    var number = ++_searchNumber;
    var query = _query.Trim();
    var scheme = _fixedScheme ?? (_scheme.Length > 0 ? _scheme : null);
    IReadOnlyList<TermRefDto>? found = null;
    await RunAsync(async () => found = await Api.SearchTermsAsync(query.Length > 0 ? query : null, scheme, Limit), toast: false);
    if (number != _searchNumber || found is null) return; // a newer search is on its way
    _results = [.. found];
    StateHasChanged(); // the first search runs from OnAfterRenderAsync, which does not re-render by itself
  }

  private void Toggle(TermRefDto term)
  {
    var at = _selected.FindIndex(s => s.Id == term.Id);
    if (at >= 0) _selected.RemoveAt(at);
    else _selected.Add(term);
  }

  private void Pick(TermRefDto term)
  {
    if (_multiple)
    {
      Toggle(term);
      return;
    }
    _selected.Clear();
    _selected.Add(term);
    Done();
  }

  private void Done() => Dialog.Close(new
  {
    ids = _selected.Select(t => t.Id.ToString()).ToArray(),
    terms = _selected.Select(t => new { id = t.Id.ToString(), name = t.Name, path = t.Path, scheme = t.SchemeKey, conceptId = t.ConceptId?.ToString() }).ToArray()
  });
}
