          "Schemes"
        ],
        "operationId": "Taxonomies_ListSchemes",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SchemeSummaryDto"
                  }
                }
