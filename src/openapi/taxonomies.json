    "title": "Taxonomies",
    "description": "Taxonomies: classification schemes (sections, genres, categories) as trees of terms, each optionally standing for a Keywords concept, as schema.org DefinedTermSet JSON-LD.",
    "version": "0.1.0"
  },
  "servers": [
